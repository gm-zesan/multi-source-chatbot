# Protect sensitive dotfiles (.env, .git, .htaccess) and internal Laravel directories
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js|docker-compose\.yml|deploy\.sh|logrotate\.conf|supervisord\.conf|.*\.md|.*\.log|.*\.sql|.*\.sqlite)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    Options +FollowSymLinks -Indexes
    RewriteEngine On

    # Block direct web access to internal application folders
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|tests|vendor|scripts|supervisor|docker|deploy|audit_evidence_bo2|scratch)(/|$) - [F,L,NC]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ /public/$1 [L]

    RewriteRule ^(/)?$ public/index.php [L]
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
</IfModule>
<IfModule lsapi_module>
</IfModule>
# END cPanel-generated php ini directives, do not edit
AddType application/x-httpd-php .html

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “alt-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
